# Public Supabase settings. Use the same names in Vercel for Production and Preview.
# Do not put a service-role key, a database password, or the Google client secret here.
# Google sign-in uses these two values only. The Google client id and secret stay in
# the Supabase Google provider, not in this file and not in Vercel.
#
# Supabase redirect URLs (exact app callback, query string is added by the app):
#   http://localhost:3000/auth/callback
#   https://storey-xi.vercel.app/auth/callback
# Preview hosts are different origins, so the production callback does not cover them.
# Add each preview callback, for example:
#   https://storey-git-feature-catalog-updates-ofergabay.vercel.app/auth/callback
# Google's own authorized redirect URI is the Supabase callback:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Google authorized JavaScript origins:
#   http://localhost:3000
#   https://storey-xi.vercel.app
#   plus a preview origin only when that preview should accept Google.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Leave unset on Vercel. pay-2026-11 is a test payment policy, not a live charge.
# STOREY_PAYMENT_POLICY=
# STOREY_PAYMENT_COHORT=
# STOREY_ADMIN_EMAILS=
